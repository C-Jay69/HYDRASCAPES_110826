# ------------------------------------------------------------------
# HYDRASCAPES — ENVIRONMENT CONFIGURATION
# Every variable below is documented: purpose, secrecy, source,
# whether optional, and behavior when absent.
# Never put real secrets in NEXT_PUBLIC_* variables.
# ------------------------------------------------------------------

# ---------- APP ----------
# Public URL of the deployed app (Vercel / other). Used for redirects and emails.
# Optional locally. Absent: dev server uses localhost defaults.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal token for machine-to-machine / n8n workflow calls.
# Secret. Must be strong and unique. Absent: machine calls are rejected.
INTERNAL_API_TOKEN=hydrascapes_secret_internal_token_change_me

# ---------- SUPABASE ----------
# Project URL from Supabase dashboard (or http://127.0.0.1:54321 for local dev).
# Secret? Publicly visible; safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key. Publicly visible; RLS is the real gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Service role key. SECRET. Server-side only, never ship to the browser.
# Absent: server actions / edge functions that need it will fail.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ---------- AI ----------
# Provider abstraction; initial provider is OpenRouter.
# Absent: AI features are disabled and degrade gracefully.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace-with-ai-key
AI_MODEL=replace-with-model
AI_REQUEST_TIMEOUT_MS=45000

# Optional fallback provider (e.g. Ollama).
AI_FALLBACK_1_PROVIDER=
AI_FALLBACK_1_MODEL=

# ---------- VISION ----------
# Property photo analysis controls.
VISION_ENABLED=true
VISION_MAX_IMAGES=20
VISION_IMAGE_MAX_PX=2048
VISION_JPEG_QUALITY=82
VISION_REANALYSIS_COOLDOWN_MIN=1440

# ---------- STRIPE ----------
# Stripe Connect, test mode.
STRIPE_SECRET_KEY=sk_test_replace
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_identity_replace

# ---------- BUSINESS POLICY ----------
# Configurable platform defaults. Absent: safe defaults used.
PLATFORM_FEE_PCT=3
DEFAULT_HOST_FEE_PCT=15
KYC_GUEST_THRESHOLD=500
DISPUTE_REVIEW_THRESHOLD=100
PAYOUT_RELEASE_HOURS_AFTER_CHECKOUT=24
AI_PRICING_MAX_ADJUSTMENT_PCT=15
VISION_PRICING_MAX_CONTRIBUTION_PCT=30

# ---------- SERVICES ----------
# Email provider abstraction, initially Resend. Absent: email disabled.
RESEND_API_KEY=

# Event provider API key (optional).
TICKETMASTER_API_KEY=

# ---------- N8N ----------
# Base URL n8n uses to reach this app for webhook/operation calls.
N8N_WEBHOOK_BASE=http://localhost:3000